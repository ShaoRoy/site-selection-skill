{
  "name": "restaurant-location-analysis",
  "displayName": "选址智能分析",
  "version": "2.10.14",
  "description": "连锁餐饮选址评估：城市网格扫描、竞品格局、截流两轴、财务双口径、行业基准对标。输出证据链报告，不做能否开店的判断。",
  "author": "RoyShao",
  "license": "MIT",
  "entry": "SKILL.md",
  "targets": {
    "workbuddy": {
      "entry": "SKILL.md",
      "runtime": "python>=3.9",
      "core": "scripts/site_core.py",
      "offlineCapable": [
        "selftest",
        "finance",
        "crs",
        "veto",
        "dedupe",
        "geo",
        "benchmark"
      ]
    },
    "dsh": {
      "entry": "SKILL.md",
      "plugin": "dsh/site-tools.ts",
      "mount": "dsh/cordis.patch.yml",
      "tools": 6
    }
  },
  "dependencies": {
    "python": [],
    "pythonOptional": [
      {
        "name": "openpyxl",
        "neededBy": "scripts/import-benchmarks.py",
        "note": "只在这一步用；其余脚本纯标准库"
      }
    ],
    "env": [],
    "envOptional": [
      {
        "name": "AMAP_API_KEY",
        "neededBy": "采集类脚本",
        "note": "缺 Key 时 finance/crs/veto/dedupe/geo/benchmark 仍可离线跑"
      },
      {
        "name": "TENCENT_MAP_KEY",
        "neededBy": "腾讯交叉校验",
        "note": "缺失时降级为单源高德，报告会注明"
      }
    ]
  },
  "coreCommands": [
    "finance",
    "crs",
    "veto",
    "dedupe",
    "geo",
    "benchmark",
    "selftest"
  ],
  "scripts": {
    "site_core": "scripts/site_core.py",
    "grid-scan": "scripts/grid-scan.py",
    "grid-registry": "scripts/grid-registry.py",
    "demand-fetch": "scripts/demand-fetch.py",
    "walk-matrix": "scripts/walk-matrix.py",
    "import-benchmarks": "scripts/import-benchmarks.py"
  },
  "params": "params/",
  "docs": [
    "docs/FEATURES.md",
    "docs/GRID.md",
    "docs/COMPLIANCE-CHECKLIST.md",
    "docs/DECISIONS.md",
    "docs/LAUNCH.md"
  ],
  "prompt": "PROMPT.md",
  "homepage": "https://github.com/ShaoRoy/site-selection-skill",
  "references": [
    "references/01-环境预检与变量字典.md",
    "references/02-计算口径全书.md",
    "references/03-数据源与治理.md",
    "references/04-输出模板.md",
    "references/05-运维与排障.md"
  ]
}